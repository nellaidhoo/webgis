# WebGIS environment template.
# Copy the relevant block to the per-service env files documented in README.md.
# Never commit real secrets.

# --- Django backend: copy to backend/.env ---
DATABASE_URL=postgis://postgres:postgres@localhost:5432/webgis
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Import service: copy to import_service/.env ---
BACKEND_URL=http://127.0.0.1:8000
UPLOADS_DIR=/opt/webgis/uploads

# --- Frontend (Next.js): set during `npm run build` (baked at build time) ---
NEXT_PUBLIC_API_URL=http://localhost/api
# Default map center (lat,lng) and zoom used on initial load (Nellaidhoo, Maldives)
NEXT_PUBLIC_MAP_CENTER_LAT=3.943
NEXT_PUBLIC_MAP_CENTER_LNG=73.489
NEXT_PUBLIC_MAP_ZOOM=15
